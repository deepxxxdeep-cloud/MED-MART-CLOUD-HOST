# Copy to .env and fill in. Never commit .env.

PORT=5001
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# Local Docker Mongo (see PROGRESS.md), or a MongoDB Atlas connection string
MONGODB_URI=mongodb://127.0.0.1:27017/medmart

# Generate with: openssl rand -hex 48
JWT_SECRET=
JWT_EXPIRES_IN=7d

# --- Phase 2: Google Sign-In (not wired yet) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Phase 3: Phone OTP via Firebase (not wired yet) ---
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
