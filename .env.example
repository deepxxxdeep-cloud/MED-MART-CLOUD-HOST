# Frontend (Vite) environment. Copy to .env and adjust. Never commit .env.
#
# Anything prefixed VITE_ is inlined into the browser bundle at build time —
# put nothing secret here. Server secrets belong in server/.env.

# Where the API lives. Left blank, the app calls /api on its own origin, which
# is what both `npm run dev` (Vite proxies it) and Vercel (api/index.js) do.
# Only set this when the API runs on a different host.
# VITE_API_URL=https://api.example.com

# In-browser fake backend: accounts, orders and payments simulated in
# localStorage, no server or database needed. Off unless explicitly "true".
# VITE_DEMO_MODE=true
